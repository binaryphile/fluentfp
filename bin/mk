#!/usr/bin/env bash

# Naming Policy:
#
# Standalone script — no namespace prefix, no global suffix.
# Functions: cmd.PascalCase (mk.bash convention).
# Locals: camelCase.  Globals: PascalCase.
# _ suffix: contains IFS characters (e.g., Usage_).

Prog=$(basename "$0")   # match what the user called
Version=0.2

read -rd '' Usage_ <<END
Usage:

  $Prog [OPTIONS] [--] COMMAND

  Commands:

    build         -- build examples/orders to bin/
    test          -- run all tests
    clean         -- remove binaries
    docs-check    -- verify showcase/README count and anchor consistency

  Options:

    -h | --help     show this message and exit
    -v | --version  show the program version and exit
    -x | --trace    enable debug tracing
END

BinDir=bin

## commands

cmd.build() {
  mkdir -p "$BinDir"
  mk.Cue go build -o $BinDir/orders ./examples/orders/
}

cmd.test() {
  mk.Cue go test ./...
}

cmd.clean() {
  rm -f "$BinDir/orders"
  rmdir "$BinDir" 2>/dev/null || true
  echo "cleaned"
}

cmd.docs-check() {
  mk.Cue python3 scripts/check-docs.py
}

## boilerplate

source ~/.local/lib/mk.bash 2>/dev/null ||
  { echo 'fatal: mk.bash not found' >&2; exit 1; }

# enable safe expansion
IFS=$'\n'
set -o noglob

mk.SetProg $Prog
mk.SetUsage "$Usage_"
mk.SetVersion $Version

return 2>/dev/null    # stop if sourced, for interactive debugging

# needsGo reports whether the requested command runs go: help, version, bare
# usage, clean and docs-check do not, so they never enter the dev shell.
needsGo() {
  local arg
  for arg in "$@"; do
    case $arg in
      -h | --help | -v | --version | clean | docs-check ) return 1 ;;
      -* ) ;;
      * ) return 0 ;;
    esac
  done
  return 1
}

# go lives only in this project's nix devShell. When a command needs it and it
# is missing from PATH, re-exec once under `nix develop` against this
# project's flake; inside the operator's own `nix develop` it resolves and
# nothing nests. MK_DEV_SHELL holds the project root of the re-exec, so a
# shell this mk entered that still lacks go fails instead of looping, while a
# marker left by another project's mk does not block entry. Replaces the
# retired bin/nix-wrapper (jeeves#84632bb9).
if needsGo "$@" && ! type -P go >/dev/null; then
  ProjectRoot=$(cd "$(dirname "$0")/.." && pwd)
  [[ ${MK_DEV_SHELL:-} != "$ProjectRoot" ]] || { echo 'fatal: nix develop did not provide go' >&2; exit 1; }
  MK_DEV_SHELL=$ProjectRoot exec nix develop $ProjectRoot -c $0 "$@"
fi

mk.HandleOptions $*   # handle standard options, returns 1-based offset
mk.Main ${*:$?}       # remaining arguments
